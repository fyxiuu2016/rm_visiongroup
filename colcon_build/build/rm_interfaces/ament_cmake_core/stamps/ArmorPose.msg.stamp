# ============================================================
# ArmorPose —— "这块板在现实中哪里"（解算节点填，发给跟踪节点）
# 解算 = 拿 Armor 的 4 个像素点 + 相机标定参数，
#        用 PnP 算法算出三维位置和朝向
# ============================================================

std_msgs/Header header

Armor armor                 # 把检测那张表原样带过来（颜色/编号/置信度），
                            # 下一个节点不用再回头查

geometry_msgs/Point position   # 板子中心的三维坐标 (x, y, z)，单位米
                               # 例如 (2.1, 0.3, -0.1) = 右前方 2 米多

float32 yaw                 # 板子朝向角，单位弧度
                            # 正对我们时接近 0，侧对时较大
