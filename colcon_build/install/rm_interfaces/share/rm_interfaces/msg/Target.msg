# ============================================================
# Target —— "敌车整车在哪、怎么动"（跟踪节点填，发给决策节点）
# 跟踪节点连续观察很多帧，用 EKF（卡尔曼滤波）估计整车运动状态
# 有了这些量，决策节点才能预测"0.1 秒后装甲板转到哪"
# 对应话题：/tracker/target
# ============================================================

std_msgs/Header header

bool tracking               # 还锁定着目标吗？false = 跟丢了，决策节点应停火停控

uint8 number                # 跟踪的是几号车（敌车可能有多辆，要锁定一辆打）

uint8 armor_num             # 这辆车身上有几块板：
                            # 普通车 4 块，平衡步兵 2 块，前哨站 3 块
                            # 知道数量才能算出"下一块板什么时候转过来"

geometry_msgs/Point position     # 整车旋转中心的位置（注意：不是某块板，是车中心）
geometry_msgs/Vector3 velocity   # 车往哪跑、多快（x/y/z 三个方向的速度）

float32 yaw                 # 车现在转到哪个角度（弧度）
float32 yaw_velocity        # 车的旋转角速度（弧度/秒）
                            # 小陀螺的关键：这个值大 = 转得欢

float32 radius_1            # 第 1 组装甲板到旋转中心的距离（米）
float32 radius_2            # 第 2 组（相邻两块板的半径可能不一样）
float32 dz                  # 两组板之间的高度差（有的车板子一高一低）
