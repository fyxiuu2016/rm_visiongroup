# ============================================================
# Armor —— "我看到一块装甲板"（检测节点填，发给解算节点）
# 只记录照片上的二维信息，此时还不知道它在现实中哪里
# ============================================================

std_msgs/Header header      # 表头：自带时间戳，记录这一帧是什么时候拍的

# ---- 颜色（常量只是给数字起名字，不占数据空间） ----
uint8 RED = 0               # 规定：红色在表里写 0
uint8 BLUE = 1              #       蓝色写 1
uint8 color                 # 这块板的颜色（填 0 或 1）

# ---- 大小（大板血厚、判定区大，打法不同） ----
uint8 SMALL = 0             # 小板写 0
uint8 BIG = 1               # 大板写 1
uint8 type                  # 大板还是小板

uint8 number                # 板子上的数字编号：
                            # 1~5 步兵/英雄，6 哨兵，7 前哨站，8 基地（依训练集定义）

float32 confidence          # 检测程序有多大把握（0~1，0.9 = 九成把握）

geometry_msgs/Point32[4] corners
                            # 板子四个角在照片上的像素位置
                            # [4] = 固定 4 个点，从左上角开始顺时针排列
